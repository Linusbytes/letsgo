{
    "scripts": {
        "build": "npx tailwindcss -i ./tailwind.css -o ./assets/css/main.css --minify && npm run copy-assets",
        "copy-assets": "npx copyfiles -u 0 \"assets/**/*\" \"style.css\" \"screenshot.png\" public",
        "watch": "npx tailwindcss -i ./tailwind.css -o ./assets/css/main.css --watch",
        "lint": "npx prettier --check ."
    },
    "devDependencies": {
        "copyfiles": "^2.4.1",
        "tailwindcss": "^3.4.18"
    }
}